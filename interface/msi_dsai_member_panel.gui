# ============================================================================
# 联合政府会议 —— 自定义面板
#
# 由 events/msi_dsai_member_events.txt 的 country_event msi_ms.10 通过
# custom_gui = "msi_dsai_ms_panel" 打开。
#
# 交互结构：
#   - 左侧五张成员国名片仍是事件选项，只是每个选项用 custom_gui 指定了自己的
#     外观容器（msi_dsai_ms_opt_1 ~ _opt_5，仿原版 enclave_caravaneer_option
#     的写法）。点选名片会完成当前事件并重开面板，右侧详情随之刷新，不会留下
#     未完成的旧窗口。
#   - 「关闭」也是选项，外观容器 msi_dsai_ms_opt_close，排在名片列表末尾。
#   - 信息栏下方的四个操作按钮是 effectButtonType，作用于当前选中成员国。
#   - 名片只保留徽记与国名：事件选项的文字由引擎画在按钮正中，再加第二行
#     会和它对叠，所以条目里不再放静态文本。
#
# 布局（窗口 1280 x 720，居中后四周留边）：
#   标题 32,14 ｜ 副标题 34,44 ｜ 名册标题 34,74
#   选项列表 32,100，480 x 568；每个条目 476 x 92（关闭条目同高，按钮靠上）
#   右侧会议记录 540,100，700 x 460
#   四个操作按钮 540,572 / 898,572 / 540,616 / 898,616，各 342 x 34
# ============================================================================

guiTypes = {
	# ========================================================================
	# 选项条目：成员国名片
	# option_button 是原版写死的名字，OPTION_TEXT 是原版约定的占位符，
	# 游戏会把选项的本地化文本填进去；trigger_icons / effect_icons 两个
	# OverlappingElementsBox 原版条目必有，缺了会取不到实例，必须保留。
	# ========================================================================
	containerWindowType = {
		name = "msi_dsai_ms_opt_1"
		position = { x = 0 y = 0 }
		size = { width = 476 height = 92 }
		moveable = no

		buttonType = {
			name = "option_button"
			quadTextureSprite = "GFX_interface_list_light"
			position = { x = 0 y = 0 }
			size = { x = 476 y = 92 }
			font = "malgun_goth_24"
			format = left
			text_offset = { x = 104 y = 10 }
			text = "OPTION_TEXT"
		}

		iconType = {
			name = "emblem"
			spriteType = "GFX_msi_dsai_ms_member_1_large"
			position = { x = 14 y = 10 }
		}

		OverlappingElementsBoxType = {
			name = "trigger_icons"
			position = { x = 386 y = 30 }
			size = { x = 65 y = 28 }
		}

		OverlappingElementsBoxType = {
			name = "effect_icons"
			position = { x = 380 y = 54 }
			size = { x = 72 y = 28 }
			format = right
		}
	}

