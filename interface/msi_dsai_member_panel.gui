# ============================================================================
# 联合政府会议 —— 自定义面板（紧凑版）
#
# 由 events/msi_dsai_member_events.txt 的 country_event msi_ms.10 通过
# custom_gui = "msi_dsai_ms_panel" 打开。
#
# 交互结构：
#   - 左侧五个成员国与“关闭”都是事件选项；点击选项会完成当前事件并重开面板，
#     右侧信息随之刷新，不会留下未完成的旧窗口。
#   - 信息栏下方的四个操作按钮是 effectButtonType，作用于当前选中成员国。
#
# 布局（窗口 1280 x 720，居中后四周留边）：
#   标题 32,14 ｜ 副标题 34,44
#   左侧选项列表 32,80，480 x 360
#   右侧会议记录 540,80，700 x 360
#   四个操作按钮 540,460 / 712,460 / 540,502 / 712,502
#   说明文本 540,550
# ============================================================================

guiTypes = {
	containerWindowType = {
		name = "msi_dsai_ms_panel"
		orientation = center
		origo = center
		moveable = yes
		size = { width = 1280 height = 720 }

		background = {
			name = "background"
			quadTextureSprite = "GFX_msi_dsai_ms_bg"
		}

		buttonType = {
			name = "close"
			quadTextureSprite = "GFX_close"
			position = { x = -32 y = 20 }
			orientation = "UPPER_RIGHT"
			shortcut = "ESCAPE"
			clicksound = "back_click"
		}

		instantTextBoxType = {
			name = "msi_dsai_ms_title"
			font = "malgun_goth_24"
			text = "msi_dsai_ms_panel_title"
			position = { x = 32 y = 14 }
			maxWidth = 700
			maxHeight = 30
			fixedSize = yes
			alwaysTransparent = yes
		}

		instantTextBoxType = {
			name = "msi_dsai_ms_subtitle"
			font = "cg_16b"
			text = "msi_dsai_ms_panel_subtitle2"
			position = { x = 34 y = 44 }
			maxWidth = 700
			maxHeight = 18
			fixedSize = yes
			alwaysTransparent = yes
		}

		# ------------------------------------------------------------------
		# 左侧：成员国与关闭（事件选项）
		# ------------------------------------------------------------------
		containerWindowType = {
			name = "EVENT_DIPLO"
			position = { x = 32 y = 80 }
			size = { width = 480 height = 360 }
			moveable = no

			listboxType = {
				name = "option_list"
				position = { x = 0 y = 0 }
				background = ""
				size = { x = 480 y = 340 }
				spacing = 1
				scrollbartype = "standardlistbox_slider"
				borderSize = { x = 0 y = 0 }
				Orientation = "UPPER_LEFT"
			}

			instantTextBoxType = {
				name = "action_title"
				font = "cg_16b"
				position = { x = -3000 y = -3000 }
				maxWidth = 100
				alwaysTransparent = yes
			}

			instantTextBoxType = {
				name = "action_desc"
				font = "cg_16b"
				position = { x = -3000 y = -3000 }
				maxWidth = 100
				alwaysTransparent = yes
			}
		}

		# ------------------------------------------------------------------
		# 右侧：会议记录（事件描述，随选中成员国刷新）
		# ------------------------------------------------------------------
		buttonType = {
			name = "alien_message_background"
			size = { x = 700 y = 360 }
			position = { x = 540 y = 80 }
			spriteType = "GFX_tiles_dark_area_cut_8"
			alwaysTransparent = yes
		}

		instantTextBoxType = {
			name = "alien_message"
			font = "cg_16b"
			position = { x = 556 y = 94 }
			maxWidth = 668
			maxHeight = 332
			format = left
			scrollbartype = "standardtext_slider"
		}

		# ------------------------------------------------------------------
		# 信息栏下方：四个操作按钮（作用于当前选中成员国）
		# ------------------------------------------------------------------
		effectButtonType = {
			name = "msi_dsai_ms_action_woo"
			quadTextureSprite = "GFX_interface_list_light"
			position = { x = 540 y = 460 }
			size = { x = 160 y = 34 }
			buttonFont = "cg_16b"
			buttonText = "msi_dsai_ms_btn_woo"
			effect = "msi_dsai_ms_btn_woo"
			clicksound = "confirm_click"
		}

		effectButtonType = {
			name = "msi_dsai_ms_action_transfer"
			quadTextureSprite = "GFX_interface_list_light"
			position = { x = 712 y = 460 }
			size = { x = 160 y = 34 }
			buttonFont = "cg_16b"
			buttonText = "msi_dsai_ms_btn_transfer"
			effect = "msi_dsai_ms_btn_transfer"
			clicksound = "confirm_click"
		}

		effectButtonType = {
			name = "msi_dsai_ms_action_sanction"
			quadTextureSprite = "GFX_interface_list_light"
			position = { x = 540 y = 502 }
			size = { x = 160 y = 34 }
			buttonFont = "cg_16b"
			buttonText = "msi_dsai_ms_btn_sanction"
			effect = "msi_dsai_ms_btn_sanction"
			clicksound = "confirm_click"
		}

		effectButtonType = {
			name = "msi_dsai_ms_action_ethic"
			quadTextureSprite = "GFX_interface_list_light"
			position = { x = 712 y = 502 }
			size = { x = 160 y = 34 }
			buttonFont = "cg_16b"
			buttonText = "msi_dsai_ms_btn_ethic"
			effect = "msi_dsai_ms_btn_ethic"
			clicksound = "confirm_click"
		}

		instantTextBoxType = {
			name = "msi_dsai_ms_help"
			font = "cg_16b"
			text = "msi_dsai_ms_panel_help"
			position = { x = 540 y = 550 }
			maxWidth = 700
			maxHeight = 120
			format = left
			alwaysTransparent = yes
		}

		# ------------------------------------------------------------------
		# 原版骨架元素：全部保留，移出可视区域
		# ------------------------------------------------------------------
		buttonType = { name = "tts_button" position = { x = -3000 y = -3000 } spriteType = "GFX_button_tts_start" }
		buttonType = { name = "focus_button" position = { x = -3000 y = -3000 } spriteType = "GFX_fleetview_focus" }
		instantTextBoxType = { name = "heading" font = "malgun_goth_24" position = { x = -3000 y = -3000 } }
		buttonType = { name = "empire_flag" position = { x = -3000 y = -3000 } spriteType = "GFX_empire_flag_128" }
		buttonType = { name = "confirm_button" position = { x = -3000 y = -3000 } quadTextureSprite = "GFX_standard_button_142_34_button" }

		containerWindowType = {
			name = "portrait_background"
			position = { x = -3000 y = -3000 }
			size = { width = 0 height = 0 }
			iconType = { name = "event_picture" spriteType = "GFX_diplomacy_portrait_frame" }
			iconType = { name = "portrait" spriteType = "GFX_portrait_character" }
		}
		containerWindowType = {
			name = "portrait"
			position = { x = -3000 y = -3000 }
			size = { width = 0 height = 0 }
			iconType = { name = "portrait" spriteType = "GFX_portrait_gamesetup_mask" }
			iconType = { name = "black_frame" spriteType = "GFX_diplomacy_portrait_shadow_frame" }
			iconType = { name = "stripes_1" spriteType = "GFX_diplomacy_stripes_2" }
			iconType = { name = "city_frame" spriteType = "GFX_diplomacy_portrait_frame" }
		}

		iconType = { name = "empire_info_bg" spriteType = "GFX_diplomacy_dark_fade_bg" position = { x = -3000 y = -3000 } }
		instantTextBoxType = { name = "empire_name" font = "malgun_goth_24" position = { x = -3000 y = -3000 } }
		instantTextBoxType = { name = "empire_government_type" font = "cg_16b" position = { x = -3000 y = -3000 } }
		instantTextBoxType = { name = "empire_personality_type" font = "cg_16b" position = { x = -3000 y = -3000 } }
		OverlappingElementsBoxType = { name = "empire_ethics_icons" position = { x = -3000 y = -3000 } }

		containerWindowType = {
			name = "leader_details"
			position = { x = -3000 y = -3000 }
			containerWindowType = { name = "empire_traits_box" }
			instantTextBoxType = { name = "empire_traits_label" font = "cg_16b" }
			overlappingElementsBoxType = { name = "leader_traits" }
			instantTextBoxType = { name = "leader_name" font = "cg_16b" }
			instantTextBoxType = { name = "leader_species" font = "cg_16b" }
		}

		containerWindowType = {
			name = "opinion_window"
			position = { x = -3000 y = -3000 }
			size = { width = 94 height = 30 }
			iconType = { name = "their_opinion_icon" spriteType = "GFX_diplomacy_opinion" }
			instantTextBoxType = { name = "their_opinion" font = "cg_16b" }
		}
	}
}
